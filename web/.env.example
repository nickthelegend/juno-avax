# Avalanche Fuji. Copy to .env.local (gitignored) and fill in.
# The JunoFactory every post was created by (deployments/fuji.json -> factory.address).
EXPO_PUBLIC_JUNO_FACTORY=0xac736951c75e849e7db40b333cc0dff2baf88539
# Optional: a Fuji RPC to read from first (the public endpoints are the fallback).
EXPO_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Where relative media paths resolve on native builds; web uses its own origin.
EXPO_PUBLIC_APP_URL=
