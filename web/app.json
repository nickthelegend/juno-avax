{
  "expo": {
    "name": "Juno",
    "slug": "juno-avax",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.launch.junoavax"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.launch.junoavax",
      "versionCode": 400
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Juno uses your photos and videos so you can launch them as a post or a reel."
        }
      ],
      "./plugins/withQuotedBundleScript"
    ],
    "scheme": "junoavax",
    "backgroundColor": "#D3E3CB",
    "description": "Every post is a coin on Avalanche: a one-minute sealed-bid opening auction with one clearing price, a bonding curve in AVAX, a floor every holder can redeem, and dare bonds. Fuji testnet."
  }
}
